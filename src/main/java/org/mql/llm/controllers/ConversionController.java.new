package org.mql.llm.controllers;

import org.mql.llm.models.ConversionResult;
import org.mql.llm.services.JspToThymeleafService;

import java.util.HashMap;
import java.util.Map;

/**
 * Cette classe a été simplifiée et convertie en classe utilitaire standard
 * pour être utilisée dans un contexte non-Spring.
 * 
 * Elle fournit les fonctionnalités de base de l'ancien contrôleur REST
 * mais sous forme d'API Java normale.
 */
public class ConversionController {
    private final JspToThymeleafService conversionService;

    public ConversionController(JspToThymeleafService conversionService) {
        this.conversionService = conversionService;
    }
    
    /**
     * Convertit le code JSP en Thymeleaf
     * 
     * @param jspCode Code JSP à convertir
     * @return Objet résultat contenant le code JSP original et le code Thymeleaf généré
     */
    public ConversionResult convertJspToThymeleaf(String jspCode) {
        if (jspCode == null || jspCode.trim().isEmpty()) {
            throw new IllegalArgumentException("Le code JSP est requis");
        }
        
        String thymeleafCode = conversionService.convertJspToThymeleaf(jspCode);
        return new ConversionResult(jspCode, thymeleafCode);
    }
    
    /**
     * Convertit le code JSP en Thymeleaf et retourne une Map avec les résultats
     * 
     * @param jspCode Code JSP à convertir
     * @return Map contenant le résultat de la conversion
     */
    public Map<String, Object> convertJspToThymeleafAsMap(String jspCode) {
        if (jspCode == null || jspCode.trim().isEmpty()) {
            Map<String, Object> error = new HashMap<>();
            error.put("error", "Le code JSP est requis");
            error.put("success", false);
            return error;
        }
        
        try {
            String thymeleafCode = conversionService.convertJspToThymeleaf(jspCode);
            
            Map<String, Object> result = new HashMap<>();
            result.put("originalCode", jspCode);
            result.put("convertedCode", thymeleafCode);
            result.put("success", !thymeleafCode.startsWith("Erreur:"));
            result.put("timestamp", java.time.LocalDateTime.now().toString());
            return result;
        } catch (Exception e) {
            Map<String, Object> error = new HashMap<>();
            error.put("error", "Erreur lors de la conversion: " + e.getMessage());
            error.put("success", false);
            return error;
        }
    }
    
    /**
     * Convertit le code JSP en Thymeleaf et retourne uniquement le code HTML
     * 
     * @param jspCode Code JSP à convertir
     * @return String contenant le code Thymeleaf généré
     */
    public String convertJspToThymeleafRaw(String jspCode) {
        if (jspCode == null || jspCode.trim().isEmpty()) {
            return "Erreur: Le code JSP est requis";
        }
        
        return conversionService.convertJspToThymeleaf(jspCode);
    }
}
